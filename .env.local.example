# Database (Hostinger MySQL)
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE_NAME"

# NextAuth
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# Verifies the CRM client-portal SSO handoff token (auth.ts's
# verifyPortalSsoToken() — HMAC-SHA256 over an unsigned header.payload,
# same shape as a JWT). Must match the CRM's own portal SSO secret for
# this integration.
PORTAL_SSO_SECRET=

# Anthropic
ANTHROPIC_API_KEY="sk-ant-..."

# Email - Hostinger SMTP
SMTP_HOST="mail.yourdomain.com"
SMTP_PORT="465"
SMTP_USER="noreply@yourdomain.com"
SMTP_PASS="your-email-password"
SMTP_FROM="Social Media Tool <noreply@yourdomain.com>"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Social Media Tool"

# NEDS CRM integration — bidirectional.
# Inbound (CRM→SMDost calls), scoped per purpose so a leaked key only grants
# what that purpose needs — this is exactly the class of key the 2026-09-18
# botnet incident abused, so provisioning is kept separate from read/briefs:
# SMDOST_SERVICE_KEY_PROVISIONING: POST /api/clients, POST /api/team.
# SMDOST_SERVICE_KEY_BRIEFS: POST /api/briefs.
# SMDOST_SERVICE_KEY_READ: GET /api/ai/usage.
SMDOST_SERVICE_KEY_PROVISIONING=
SMDOST_SERVICE_KEY_BRIEFS=
SMDOST_SERVICE_KEY_READ=
# SMDOST_SERVICE_KEY: the inbound legacy-fallback acceptance has been
# retired (2026-09-18, the CRM is confirmed on the 3 scoped keys above) —
# but DO NOT remove this var. It's still the real, unchanged Bearer token
# SMDost itself sends OUTBOUND to the CRM's own webhooks
# (lib/crm-webhook.ts), a separate trust boundary the inbound scoping
# above never touched. Must keep matching the CRM's own SMDOST_SERVICE_KEY
# for that direction.
SMDOST_SERVICE_KEY=
# CRM_WEBHOOK_URL: base URL of the NEDS CRM (no trailing slash).
#   SMDost posts to {CRM_WEBHOOK_URL}/api/webhooks/smdost/brief-approved
#   when all content in a brief is approved.
CRM_WEBHOOK_URL=https://crm.niranjanenterprises.co.in

# nedsdrishti.in integration — SMDost pushes approved content as scheduled posts.
# DRISHTI_SERVICE_KEY must match SERVICE_API_KEY in the Drishti server .env.
# DRISHTI_API_URL: base URL of the Drishti API (no trailing slash).
DRISHTI_SERVICE_KEY=
DRISHTI_API_URL=https://nedsdrishti.in

# Meta Ads Manager push (Tier 3 backlog item, phase 1 — scaffolded 2026-08-12,
# not yet wired to real credentials). Pushes an APPROVED Meta Ads copy variant
# to the NEDS house ad account's Creative library only (no Campaign/AdSet/Ad,
# never touches budget/targeting/spend). See lib/meta-ads.ts for full scope
# rationale. Leaving any of these blank disables the feature entirely
# (metaAdsConfigured() returns false) — the push button/route just won't work,
# nothing else in the app is affected.
# META_ADS_ACCESS_TOKEN: a Business Manager System User token with
#   ads_management on the house ad account (Business Settings > System Users).
#   Requires: verified Business Manager + a live app with the Marketing API
#   product enabled ("Limited Access" tier) — NOT full App Review, as long as
#   this stays scoped to NEDS's own account (see META_ADS_HOUSE_CLIENT_ID).
META_ADS_ACCESS_TOKEN=
# META_AD_ACCOUNT_ID: NEDS's own ad account id, with or without the "act_" prefix.
META_AD_ACCOUNT_ID=
# META_PAGE_ID: the NEDS Facebook Page id the ad creative is attributed to
# (Meta requires a page_id on every link creative).
META_PAGE_ID=
# META_ADS_HOUSE_CLIENT_ID: the Client.id (in this app's own DB) representing
# NEDS's own house account. The push route hard-refuses any Content whose
# brief.clientId doesn't match this — phase 1 is house-account-only by design.
META_ADS_HOUSE_CLIENT_ID=
# META_GRAPH_API_VERSION: defaults to v21.0 in code if unset — verify against
# Meta's current stable Graph API version before the first real push, API
# versions retire on a schedule.
META_GRAPH_API_VERSION=

# Google Ads paused-draft push (house account only, see lib/google-ads.ts).
# GOOGLE_ADS_CLIENT_ID / GOOGLE_ADS_CLIENT_SECRET: from the "NextJS Web App
#   Social Media Dost" OAuth client in Google Cloud Console (Credentials).
# GOOGLE_ADS_REFRESH_TOKEN: generate once via
#   `node --env-file=.env.local scripts/google-ads-oauth-setup.js`
#   (needs CLIENT_ID/CLIENT_SECRET already set first).
# GOOGLE_ADS_DEVELOPER_TOKEN: from the Google Ads API Center under MCC
#   775-887-1747 — needs at least Basic access to work outside test accounts.
# GOOGLE_ADS_LOGIN_CUSTOMER_ID: the MCC (manager) account id, digits only.
# GOOGLE_ADS_CUSTOMER_ID: the house Ads account objects are created under,
#   digits only.
# GOOGLE_ADS_HOUSE_CLIENT_ID: this app's own Client.id representing NEDS's
#   house account — the push route hard-refuses any other client.
# GOOGLE_ADS_API_VERSION: defaults to v17 in code if unset — verify against
#   Google's current stable API version before first real use.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_HOUSE_CLIENT_ID=
GOOGLE_ADS_API_VERSION=
